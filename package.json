    "@rn-primitives/avatar": "^1.0.4",
    "@shopify/flash-list": "2.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "expo": "^54.0.0",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.13",
    "expo-device": "~8.0.9",
    "expo-haptics": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.10",
    "expo-status-bar": "~3.0.8",
