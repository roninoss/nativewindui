    "@rn-primitives/avatar": "^1.0.4",
    "@shopify/flash-list": "1.7.6",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "expo": "^53.0.0",
    "expo-constants": "~17.1.7",
    "expo-dev-client": "~5.2.4",
    "expo-haptics": "~14.1.4",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.7",
    "expo-status-bar": "~2.2.3",
    "expo-store-review": "~8.1.5",
    "expo-symbols": "~0.4.5",
